{
  "version": 2,
  "buildCommand": "npm run build",
  "crons": [
    { "path": "/api/scheduler/run", "schedule": "0 0 * * *" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/", "destination": "/api/index" },
    { "source": "/crm", "destination": "/api/index" },
    { "source": "/comercial", "destination": "/api/index" },
    { "source": "/almacen", "destination": "/api/index" },
    { "source": "/reparto", "destination": "/api/index" },
    { "source": "/web", "destination": "/api/index" },
    { "source": "/ocr", "destination": "/api/index" },
    { "source": "/portal-pedidos", "destination": "/api/index" },
    { "source": "/portal-ofertas", "destination": "/api/index" },
    { "source": "/seguimiento/:token", "destination": "/api/index" },
    { "source": "/_next/:path*", "destination": "/api/index" },
    { "source": "/favicon.svg", "destination": "/api/index" },
    { "source": "/favicon.ico", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/**"
    }
  }
}
