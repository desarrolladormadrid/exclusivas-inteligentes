# Excluvas Inteligentes se ejecuta localmente.
# La configuración del asistente se introduce desde el panel ⚙ del CRM.
# Nunca guardes una API key real en este archivo.
CRM_API_PORT=3001
CRM_DATA_DIR=./data

DATABASE_MODE=local
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=pon_aqui_un_token_de_base_de_datos

# Cloudinary: nunca subas valores reales a GitHub ni a AGENTS.md.
# El API Secret solo debe existir en el servidor/Vercel, nunca en el navegador.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=pon_aqui_el_api_secret
CLOUDINARY_UPLOAD_PRESET=opcional_para_subida_sin_firma
